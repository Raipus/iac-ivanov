cloud-init.yaml

# ключи и секреты в репозиторий не попадают
*key*.json
*.pem
*.key
.env

# служебное
*.log
*.tmp

# состояние Terraform: содержит идентификаторы и секреты
*.tfstate
*.tfstate.*
# скачанные провайдеры: восстанавливаются командой init
.terraform/

# значения с секретами
*.auto.tfvars
